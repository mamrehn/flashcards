{
    "name": "flashcards",
    "version": "1.0.0",
    "description": "Flashcards Learning App",
    "private": true,
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "test": "node --test",
        "test:e2e": "playwright test",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^9.14.0",
        "@playwright/test": "^1.63.0",
        "eslint": "^9.14.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jsdoc": "^62.9.0",
        "eslint-plugin-sonarjs": "^4.0.3",
        "eslint-plugin-unicorn": "^50.0.1",
        "globals": "^15.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.10",
        "prettier": "^3.3.3"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix --no-warn-ignored",
            "prettier --write"
        ],
        "*.{json,css,html}": [
            "prettier --write"
        ]
    }
}
