{
    "name": "flashcards",
    "version": "1.0.0",
    "description": "Flashcards Learning App",
    "private": true,
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.1.0",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.7",
        "eslint-plugin-jsdoc": "^62.8.0",
        "eslint-plugin-sonarjs": "^4.0.3",
        "eslint-plugin-unicorn": "^50.0.1",
        "globals": "^15.4.0",
        "husky": "^9.1.0",
        "lint-staged": "^17.0.7",
        "prettier": "^3.3.0"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,html}": [
            "prettier --write"
        ]
    }
}